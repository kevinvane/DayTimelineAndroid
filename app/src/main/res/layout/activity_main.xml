<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!--
      XML 配置示例（PRD §10.1 / FC-005「界面配置」侧）。
      与代码侧 setConfig(TimelineConfig(...)) 一一对应、效果完全一致。
      这里故意改动几项，便于在真机上一眼看出 XML 配置确实生效。
    -->
    <com.github.kevinvane.daytimeline.library.DayTimelineView
        android:id="@+id/timeline"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:dtHourHeight="64dp"
        app:dtAxisWidth="60dp"
        app:dtBlockCorner="6dp"
        app:dtShowTimeSubtitle="true"
        app:dtNowIndicatorTodayOnly="true"
        app:dtSnapMinutes="5"
        app:dtTimeFormat="h24"
        app:dtEdgeAutoScrollEnabled="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/edit_actions"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 编辑态「完成 / 取消 / 删除」入口（PRD FI-008 / FI-009 / FI-011） -->
    <LinearLayout
        android:id="@+id/edit_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btn_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="取消"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btn_delete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="删除"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btn_done"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="完成" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
